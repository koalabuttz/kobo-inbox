# Copy to .env next to compose.yaml and adjust. Only needed for Docker.
# Address on this machine that the container listens on (127.0.0.1 = this machine only).
BIND_ADDR=127.0.0.1
HOST_PORT=8080
# User/group that owns ./data (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Optional: your own usernames and passwords (passwords need 12+ characters).
# Leave unset to use "upload" / "reader" with passwords generated into
# data/credentials.txt on first start. Apply changes with: docker compose up -d
# UPLOAD_USER=
# UPLOAD_PASSWORD=
# READER_USER=
# READER_PASSWORD=
# Allow passwords shorter than 12 characters (not recommended on the internet).
# ALLOW_WEAK_PASSWORDS=1
# MAX_UPLOAD_MB=90
